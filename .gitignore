# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Secrets: named explicitly so a future loosening of the glob above can never
# expose them. Only the placeholder template (.env.example) is committable.
.env
.env.local
.env.*.local
*.pem
*.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (local SQLite, not version-controlled)
dev.db
prisma/dev.db

# generated SQLite test schema/client (from scripts/generate-test-schema.mjs)
prisma/schema.test.prisma
prisma/test-client/

# AutoClaw KDream data
.autoclaw/
