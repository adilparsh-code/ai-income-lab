# ============================================================================
# AI Income Lab — Environment Configuration
#
# Copy this file to `.env` locally (or set these values in your deployment
# platform's environment) and fill in the real values.
# Never commit real values — only this template with safe placeholders.
# ============================================================================

# --- Database (REQUIRED before any live database operation) -------------------
# Provider note: the app connects through @prisma/adapter-pg, which takes a
# standard PostgreSQL connection string. The production provider is NOT recorded
# in this repository (operator to confirm). The URL examples below are
# Supabase-shaped; use the shape your provider documents.
# Copy this file to `.env.local` (git-ignored) and put the REAL values there, or
# set them in your deployment platform's secret store. Never commit real values.
#
# DATABASE_URL — application/runtime connection (PostgreSQL), used by the app
#   through the official @prisma/adapter-pg driver. If your provider offers a
#   PgBouncer-style transaction pooler, use it here (Supabase shape: port 6543,
#   add `?pgbouncer=true`). When unset
#   the app fails fast in production and falls back to a local SQLite file in
#   development.
# DIRECT_URL   — direct/session connection (port 5432) used by the Prisma 7 CLI
#   (`prisma7 migrate status|deploy`) and by offline schema generation. The
#   transaction pooler is PgBouncer, which rejects the CLI engine's prepared
#   statements, so CLI operations must not use port 6543. Falls back to
#   DATABASE_URL when unset.
#
# Two host shapes — use the one the network can reach:
#   Direct connection (IPv6 only: it publishes an AAAA record and no A record):
#     DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
#     DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
#   Shared pooler (IPv4; note the `postgres.<project-ref>` username):
#     DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#     DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Append `sslmode=require` to any shape to refuse an unencrypted connection, and
# percent-encode URL-special characters in the password (@ : / ? # & %) — a raw
# `@` or `:` splits the userinfo field and the URL no longer parses.
# Hermetic tests and local development may use a SQLite file URL instead
# (`file:./dev.db`); that dialect is test/local only and must never be deployed.
#
# Both stay EMPTY in this template. An empty value is treated as "not
# configured": it grants nothing and is never substituted for a real secret.
# See docs/database-operations.md for the operator verification steps.
DATABASE_URL=""
DIRECT_URL=""

# --- Supabase client (optional, client-safe) ----------------------------------
# Reserved for a browser/SSR Supabase client. No module in this repository reads
# these values yet, so they can be omitted; the server-side data path stays on
# DATABASE_URL above.
# The publishable key is not a secret — it is designed to be delivered to
# browsers. Never put a database password, a `sb_secret_…` key, or a legacy
# `service_role` key behind a NEXT_PUBLIC_ prefix: everything with that prefix is
# embedded in the client bundle.
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_…"

# --- App ---------------------------------------------------------------------
# Client-safe display name. NEVER put secrets behind a NEXT_PUBLIC_ prefix —
# anything with NEXT_PUBLIC_ is embedded into the client bundle.
NEXT_PUBLIC_APP_NAME="AI Income Lab"

# Optional environment override: development | production | test.
# (Next derives this from NODE_ENV automatically; only set to override.)
# APP_ENV="development"

# --- AI Provider (Phase 4.2.2 — server-side only) ----------------------------
# Default is "mock": deterministic in-process provider, no key, no network.
# Set to "gemini" + a valid AI_PROVIDER_API_KEY for real Gemini research calls.
# "openai" is not yet implemented — requesting it is an explicit configuration
# error; it never silently falls back to mock.
AI_PROVIDER="mock"
# Server-only secret for real providers (Gemini API key). Leave empty in mock mode.
# NEVER use a NEXT_PUBLIC_ prefix for secrets — it leaks into the client bundle.
AI_PROVIDER_API_KEY=""
# Generation safety rails.
AI_TIMEOUT_MS="25000"
AI_MAX_RETRIES="2"
AI_DAILY_BUDGET_USD="2.00"
# Optional per-purpose model overrides (model names only, no secrets).
# AI_MODEL_RESEARCH=""
# AI_MODEL_VALIDATION=""
# AI_MODEL_PRODUCT=""
# AI_MODEL_ANALYTICS_NARRATIVE=""
# AI_MODEL_BM_NARRATIVE=""
# Optional: run the live (network) test cases. They are EXCLUDED by default so the
# standard `npm test` suite never depends on a live Gemini key.
# AI_LIVE_TESTS="false"

# ============================================================================
# Variables below were read by the code but missing from this template
# (Phase 1 reconciliation). ALL are server-side only. Leave empty to keep the
# feature in its honest NOT_CONFIGURED / fail-closed state. NEVER commit values.
# Full descriptions: docs/credentials.md
# ============================================================================

# --- Admin (single administrator; no signup, no user table) -------------------
# Fail-closed when neither a hash nor a password is configured.
ADMIN_EMAIL=""
# Preferred: scrypt hash from `node scripts/hash-admin-password.mjs`.
ADMIN_PASSWORD_HASH=""
# Bootstrap-only plaintext fallback (dev/bootstrap). Prefer the hash.
# ADMIN_PASSWORD=""
# Set to true to ignore ADMIN_PASSWORD and require the hash (migration switch).
# ADMIN_REQUIRE_PASSWORD_HASH="false"
# Kill switch: a truthy value refuses all admin logins.
# ADMIN_DISABLED="false"
# Absolute session lifetime in ms (bounded 30 min .. 7 days; default 12 h).
# ADMIN_SESSION_TTL_MS="43200000"
# Login lockout tuning (bounded; defaults 5 / 20 / 900).
# LOGIN_LOCKOUT_IP_MAX_FAILURES="5"
# LOGIN_LOCKOUT_ACCOUNT_MAX_FAILURES="20"
# LOGIN_LOCKOUT_WINDOW_SECONDS="900"

# --- Operator endpoints (fail-closed 503 when unset) --------------------------
# Generate each with e.g. `openssl rand -base64 48`. They MUST differ.
OPERATOR_CONTROL_TOKEN=""
OPERATOR_REVENUE_TOKEN=""
# Salt for keyed credential fingerprints in audit logs (optional).
# SECURITY_FINGERPRINT_SALT=""

# --- Ruflo (third-party ruvnet/ruflo, external orchestrator) ------------------
# INBOUND: Ruflo calls this app at /api/ruflo/runtime/*. Both must be set for
# the runtime handle to register; otherwise status stays NOT_CONFIGURED.
RUFLO_RUNTIME_TOKEN=""
RUFLO_RUNTIME_ENABLED="false"
# RUFLO_RUNTIME_ID="ruflo-runtime"
# RUFLO_DISPATCH_TIMEOUT_MS="120000"
# OUTBOUND: this app calling a Ruflo V3 HTTP/MCP server (optional).
# RUFLO_MCP_URL=""
# RUFLO_MCP_TOKEN=""
# RUFLO_MCP_TIMEOUT_MS="10000"
# RUFLO_RESEARCH_FRESHNESS_DAYS="14"

# --- Publishing / payments — Polar (optional) ---------------------------------
POLAR_ACCESS_TOKEN=""
POLAR_ORG_ID=""
POLAR_WEBHOOK_SECRET=""

# --- Deployment — Vercel API (optional, product deployment adapter) -----------
# VERCEL_TOKEN=""
# VERCEL_TEAM_ID=""
# VERCEL_PROJECT_ID=""
# Public base URL of this app (used for event/revenue callbacks).
# NEXT_PUBLIC_APP_URL=""
# NEXT_PUBLIC_SITE_PROTOCOL="https:"

# --- Research providers (optional) --------------------------------------------
# RESEARCH_SEARCH_PROVIDER="searxng"   # searxng | tavily
# RESEARCH_SEARXNG_URL=""
# TAVILY_API_KEY=""

# --- AI token budgets (optional; positive numbers) ----------------------------
# AI_DAILY_TOKEN_BUDGET=""
# AI_MONTHLY_TOKEN_BUDGET=""
# AI_MAX_REQUEST_INPUT_TOKENS="24000"

# --- Market and growth thresholds (non-secret, optional) ----------------------
# AI_INCOME_MARKET="GLOBAL"            # GLOBAL | IN
# GROWTH_PROVEN_REVENUE_MINOR="50000"
# GROWTH_PROMISING_REVENUE_MINOR="5000"
# GROWTH_MIN_VISITORS_MINOR="30"
# BUILDER_MAX_ATTEMPTS="2"                 # integer 1-5
