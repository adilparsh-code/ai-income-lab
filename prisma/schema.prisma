generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Opportunity {
  id                    String   @id @default(cuid())
  title                 String
  category              String
  businessModel         String
  targetAudience        String
  problemSolved         String
  monetizationMethod    String
  estimatedStartupCost  Float    @default(0)
  
  // Scores (0-100)
  demandScore           Int      @default(0)
  competitionScore      Int      @default(0)
  commercialIntentScore Int      @default(0)
  automationScore       Int      @default(0)
  differentiationScore  Int      @default(0)
  monetizationScore     Int      @default(0)
  halalConfidenceScore  Int      @default(100)
  overallScore          Int      @default(0)
  
  halalStatus           String   @default("HALAL")    // HALAL, REVIEW_REQUIRED, NOT_ALLOWED
  confidenceLevel       String   @default("MEDIUM")   // VERY_HIGH, HIGH, MEDIUM, LOW, VERY_LOW, SAMPLE_DATA
  status                String   @default("IDEA")     // IDEA, RESEARCHING, VALIDATING, VALIDATED, BUILDING, PUBLISHED, EARNING, SCALING, PAUSED, REJECTED
  
  evidenceNotes         String   @default("")
  risks                 String   @default("")
  nextAction            String   @default("")
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastReviewedAt        DateTime?
  
  products              Product[]
  experiments           Experiment[]
  revenues              Revenue[]
  contents              Content[]
  pipelineRuns          PipelineRun[]
  evidenceItems         EvidenceItemModel[]
  jobRuns               JobRun[]
  workflowRuns          WorkflowRun[]
  missions              AgentMission[]
  loopTransitions       LoopTransition[]
  simulationRuns        SimulationRun[]
  operationalMemories   OperationalMemory[]
  failureRecords        FailureRecord[]
  portfolioItems        PortfolioItem[]
  growthExperiments     GrowthExperiment[]
  growthDecisions       GrowthDecision[]
  learningEntries       LearningEntry[]
  resourceAllocations   ResourceAllocation[]
  offers                Offer[]
}

model Product {
  id              String   @id @default(cuid())
  name            String
  type            String
  targetAudience  String   @default("")
  status          String   @default("IDEA")
  price           Float    @default(0)
  cost            Float    @default(0)
  revenue         Float    @default(0)
  platform        String   @default("")
  productUrl      String   @default("")
  affiliateUrl    String   @default("")
  notes           String   @default("")
  
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?
  
  revenues        Revenue[]
  contents        Content[]
  // Phase 11.2 — an Offer may present a Product for sale. The Offer never
  // duplicates Product data; it only adds commercial terms.
  offers          Offer[]

  // Phase 5.3 — Product Factory additions (all optional; additive only).
  solution        String   @default("")
  userFlows       String   @default("[]")   // JSON array of {name, steps[]}
  techRequirements String  @default("[]")   // JSON array of strings
  acceptanceCriteria String @default("[]")  // JSON array of strings
  lifecycleHistory String  @default("[]")   // JSON array of transition records

  builds          ProductBuild[]
  deployments     ProductDeployment[]
  assets          ProductAsset[]
  events          ProductEvent[]
}

// Phase 5.3 — Product build runs. One row per build attempt against the
// build contract. Stores status, artifact reference, test summary, and a
// BOUNDED log summary (never raw logs, never secrets). A build can never set
// a product DEPLOYED/PUBLISHED by itself — only the deployment/publishing
// provider confirmations can.
model ProductBuild {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])

  status        String   // NOT_BUILT, SUCCEEDED, FAILED, UNAVAILABLE
  version       String?
  artifactRef   String?

  // Bounded test/log summaries (JSON; safe fields only).
  tests         String   @default("{}")
  logSummary    String   @default("")
  qualityGates  String   @default("[]")

  sandboxed     Boolean  @default(true)
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([productId, createdAt])
}

// Phase 5.3 — Product deployment runs. A product is DEPLOYED only when a real
// provider confirmation (deploymentId + url) exists on a row here; the
// unavailable adapter writes DEPLOYMENT_NOT_CONNECTED rows with no ids.
model ProductDeployment {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])

  status        String   // DEPLOYMENT_NOT_CONNECTED, DEPLOYED, FAILED, ROLLED_BACK, ...
  providerId    String?
  deploymentId  String?
  url           String?
  version       String?
  errors        String   @default("[]")

  // Publication of the action requires an explicit human approval token.
  // The token itself is NEVER stored — only its presence and a hash hint.
  approved      Boolean  @default(false)
  approvalTokenHash String @default("")

  correlationId String?
  createdAt     DateTime @default(now())

  @@index([productId, createdAt])
}

// Phase 5.3 — Product assets with provenance and rights tracking. An asset
// can only be marked publishable when rights are CLEAR/OWNED; unclear rights
// force HUMAN_REVIEW and blocked assets stay unpublishable.
model ProductAsset {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])

  assetType         String   // PRODUCT_IMAGE, SCREENSHOT, THUMBNAIL, PREVIEW, LISTING_GRAPHIC
  source            String   // GENERATED, MANUAL_UPLOAD, THIRD_PARTY
  provenance        String   // AI_GENERATED, USER_ENTERED, VERIFIED_DATA, MOCKED
  rightsStatus      String   // CLEAR, OWNED, UNCLEAR, HUMAN_REVIEW
  publicationStatus String   // NOT_PUBLISHABLE, PUBLISHABLE, PUBLISHED, HUMAN_REVIEW

  origin            String   @default("")  // URL or description of origin (no credentials)
  createdAt         DateTime @default(now())

  @@index([productId, createdAt])
}


// ============================================================================
// ============================================================================

/// A deterministic product specification: the minimum validated request that
/// defines WHAT product should be generated. Equivalent logical specifications
/// share the same `canonicalHash` (computed from the sorted-key canonical form
/// of the specification fields in `canonical.ts`), so duplicate creation is
/// conflict-free at the database level and idempotent at the service level.
// ============================================================================
// PHASE B1 - PRODUCT FACTORY CORE (deterministic spec -> generation -> version ->
// package). Additive only; new tables are fully independent of the existing
// digital-product lifecycle. Existing products/deployments/assets/offers/
// revenue/auth/dashboard/store are untouched.
// ============================================================================

/// A deterministic product specification: the minimum validated request that
/// defines WHAT product should be generated. Equivalent logical specifications
/// share the same `canonicalHash` (computed from the sorted-key canonical form
/// of the specification fields in `canonical.ts`), so duplicate creation is
/// conflict-free at the database level and idempotent at the service level.
model ProductSpecification {
  id             String   @id @default(cuid())
  /// Human label. Not part of the canonical identity; only for display.
  label          String   @default("")
  /// Canonical JSON of the specification fields used for identity. Stable across
  /// equivalent specs regardless of key order or transient metadata.
  canonicalBody  String
  /// SHA-256 of the canonical body. DB-unique: two concurrent requests for the
  /// same logical spec collide here and resolve to the same specification.
  canonicalHash  String   @unique

  // Origin metadata (not canonical). Used for audit, not identity.
  requestedBy    String   @default("")
  source         String   @default("")  // e.g. 'manual', 'pipeline', 'api'

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// One or more generations may be produced from a specification. A new
  /// generation is created for each actual generation attempt - a historical
  /// version is never mutated.
  generations    ProductGeneration[]

  /// Product versions are produced BY a generation. Versions are immutable
  /// historical artifacts: packaging never mutates an existing version.
  @@index([canonicalHash])  // lookup by identity
}

/// One concrete generation of a specification. Every generation preserves:
///   - the specification identity (specificationId)
///   - the generation identity (id)
///   - the generation mode (generationMode) - persisted, never request-only metadata
///   - the resulting product version (ProductVersion)
///
/// `generationMode` names HOW the product was generated (e.g. 'autonomous-pipeline',
/// 'deterministic-builder', 'manual-review', 'imported'). It is a persisted,
/// auditable fact, not a transient request field.
model ProductGeneration {
  id               String   @id @default(cuid())
  specificationId  String
  specification    ProductSpecification @relation(fields: [specificationId], references: [id])

  generationMode   String   // persisted generation mode; never empty
  status           String   @default("PENDING") // PENDING | IN_PROGRESS | SUCCEEDED | FAILED
  outcomeSummary   String   @default("{}")     // bounded, safe summary

  /// Stable generation identity carried into the resulting version. Deterministic
  /// from (specification canonical hash + generation mode + attempt), so the
  /// version can be re-derived without relying on mutable DB state.
  generationRef    String

  createdAt        DateTime @default(now())
  completedAt      DateTime?

  versions         ProductVersion[]

  @@index([specificationId, createdAt])
  @@index([generationRef])
}

/// An immutable generated product version. A version is a historical artifact:
/// its canonical identity, generated content, and generation mode are never
/// overwritten. If the product should change, a NEW generation + NEW version is
/// created from the (possibly new) specification.
///
/// Versions optionally link to the Product model the lab tracks as a plain column
/// (no relation on Product), so the existing Product/build/deploy/asset lifecycle
/// is not extended at all.
model ProductVersion {
  id                 String   @id @default(cuid())
  generationId       String
  generation         ProductGeneration @relation(fields: [generationId], references: [id])

  /// Optional link to the existing Product row the lab tracks. Not a Prisma
  /// relation (Product is unchanged); stored as a plain reference for
  /// traceability without extending the core Product model.
  productId          String?

  /// Version identity derived from the generation, kept for audit even if the
  /// product row is deleted/changed later.
  versionLabel       String
  /// The immutable generated content for this version. Stored as JSON; never
  /// mutated after creation. Packaging reads from here.
  content            String   @default("{}")
  /// The generation mode that produced this version. Persisted with the version
  /// so a version is self-describing and immutable with respect to how it was made.
  generationMode     String

  /// Canonical identity of the version content (SHA-256 of the canonical JSON
  /// of the version content fields). Used for immutability audits and deduplication
  /// of packaging.
  contentCanonicalHash String

  createdAt          DateTime @default(now())

  packages           ProductPackage[]

  @@unique([generationId, versionLabel])  // one label per generation
  @@unique([generationId, contentCanonicalHash])  // one content per generation
  @@index([generationId])
  @@index([productId])
}

/// A deterministic package/artifact representation for a generated product
/// version. A package is traceable to:
///   Specification -> Generation -> ProductVersion -> Package
///
/// Packaging MUST NOT mutate an existing historical version. A package is a new,
/// immutable row that references the version it was packaged from.
model ProductPackage {
  id            String   @id @default(cuid())

  versionId     String
  version       ProductVersion @relation(fields: [versionId], references: [id])

  /// The package kind/format (e.g. 'build-manifest', 'artifact-bundle-descriptor',
  /// 'listing-draft', 'deployment-package').
  packageType   String
  /// Deterministic package content (JSON). Frozen at creation.
  packageBody   String
  /// Canonical hash of the package body (for audit + immutability).
  packageHash   String   @unique

  /// Optional reference to where the package artifact lives (path/id/url). No
  /// secrets; a relative reference or label, not credentials.
  artifactRef   String   @default("")

  createdAt     DateTime @default(now())

  @@index([versionId, createdAt])
  @@index([packageHash])
}

model Experiment {
  id              String   @id @default(cuid())
  hypothesis      String
  target          String   @default("")
  budget          Float    @default(0)
  startDate       DateTime?
  endDate         DateTime?
  expectedResult  String   @default("")
  actualResult    String   @default("")
  
  visitors        Int      @default(0)
  leads           Int      @default(0)
  clicks          Int      @default(0)
  sales           Int      @default(0)
  revenue         Float    @default(0)
  profit          Float    @default(0)
  conversionRate  Float    @default(0)
  
  decision        String?  // SCALE, ITERATE, PAUSE, KILL
  
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// PHASE 9 — Autonomous Growth + Optimization Engine
// Additive only. Deterministic, explainable, bounded. Reuses the existing
// Experiment/ProductEvent/Revenue/JobRunner boundaries; never stores secrets
// and never mixes simulated figures with real revenue.
// ============================================================================

/// Portfolio view of one opportunity. One row per opportunity (upserted).
/// Aggregates are recomputed from REAL rows (events/revenue/experiments);
/// they never invent market or revenue facts.
model PortfolioItem {
  id                    String   @id @default(cuid())
  opportunityId         String   @unique
  opportunity           Opportunity @relation(fields: [opportunityId], references: [id])

  // Denormalized deterministic aggregates (recomputed, never user-set).
  traffic               Int      @default(0)
  conversions           Int      @default(0)
  revenueUsd            Float    @default(0)
  costsUsd              Float    @default(0)
  profitUsd             Float    @default(0)
  experimentCount       Int      @default(0)
  activeExperimentCount Int      @default(0)

  // Deterministic health output (rules in src/lib/growth/health.ts).
  health                String   @default("NEEDS_DATA")  // HEALTHY, WATCH, NEEDS_DATA, UNDERPERFORMING, STOPPED, BLOCKED
  trend                 String   @default("FLAT")        // UP, FLAT, DOWN, UNKNOWN
  confidence            String   @default("LOW")         // LOW, MEDIUM, HIGH
  score                 Int      @default(0)             // 0..100 deterministic portfolio score
  explanation           String   @default("")            // human-readable rule trace

  halalStatusSnapshot   String   @default("HALAL")
  opportunityStatusSnapshot String @default("IDEA")
  evidenceStrengthSnapshot  String  @default("LOW")
  validationStatusSnapshot  String  @default("NOT_VALIDATED")
  productStatusSnapshot     String  @default("")

  lastActivityAt        DateTime?
  evaluatedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  experiments           GrowthExperiment[]
  allocations           ResourceAllocation[]

  @@index([health])
  @@index([evaluatedAt])
}

/// One bounded growth experiment per (opportunity, idempotency key).
/// Execution always goes through the Job Runner; halal/authorization gates
/// are enforced before any spend. Budgets are hard-capped in code.
model GrowthExperiment {
  id             String   @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  portfolioItemId String?
  portfolioItem  PortfolioItem? @relation(fields: [portfolioItemId], references: [id])

  experimentType String   // LANDING_PAGE, CTA, PRICING, CONTENT, TRAFFIC_SOURCE, POSITIONING, ONBOARDING
  hypothesis     String
  metric         String   // CONVERSION_RATE, CTR, REVENUE_PER_VISITOR, SIGNUPS, REVENUE
  baselineValue  Float    @default(0)
  targetValue    Float

  budgetUsd      Float
  spentUsd       Float    @default(0)
  maxDurationDays Int
  startedAt      DateTime @default(now())
  endsAt         DateTime
  stoppedAt      DateTime?
  stopReason     String?

  status         String   @default("DRAFT") // DRAFT, ACTIVE, COMPLETED, STOPPED, BLOCKED, HUMAN_REVIEW

  // Measured outcome (from recorded events/revenue only — never fabricated).
  variantVisitors Int     @default(0)
  variantConversions Int  @default(0)
  variantValueUsd   Float @default(0)
  controlValueUsd   Float @default(0)
  resultSummary  String   @default("")
  evidenceType   String   @default("VERIFIED_DATA")

  // Lifecycle safety: bounded execution attempts + stop conditions.
  executionAttempts Int   @default(0)
  failureCount   Int      @default(0)
  stopLossThreshold Float
  requiresApproval Boolean @default(false)
  correlationId  String
  idempotencyKey String   @unique

  decisions      GrowthDecision[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([opportunityId, status])
  @@index([status, endsAt])
  @@index([correlationId])
}

/// Append-only growth decision ledger. One row per deterministic evaluation.
/// Human decisions are recorded with evidenceType HUMAN_DECISION and are
/// authoritative over engine recommendations.
model GrowthDecision {
  id             String   @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  experimentId   String?
  experiment     GrowthExperiment? @relation(fields: [experimentId], references: [id])

  decision       String   // CONTINUE, ITERATE, PAUSE, STOP, SCALE_WITHIN_BUDGET, NEEDS_HUMAN_REVIEW
  reason         String
  evidenceType   String   @default("VERIFIED_DATA")
  evidence       String   @default("")
  decidedBy      String   @default("growth-engine") // growth-engine | business-manager | human
  metricsJson    String   @default("{}")
  correlationId  String
  createdAt      DateTime @default(now())

  @@index([opportunityId, createdAt])
  @@index([experimentId])
  @@index([decision])
}

/// Business memory: persisted learning from completed/stopped experiments.
/// Future decisions consume verified entries; AI-inferred entries are stored
/// but never treated as verified truth.
model LearningEntry {
  id             String   @id @default(cuid())
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  experimentId   String?

  hypothesis     String
  result         String   // VALIDATED, INVALIDATED, INCONCLUSIVE
  metric         String   @default("")
  baselineValue  Float    @default(0)
  measuredValue  Float    @default(0)
  decision       String
  context        String   @default("")
  evidenceType   String   @default("VERIFIED_DATA")
  applicability  String   @default("")
  confidence     Float    @default(0)

  createdAt      DateTime @default(now())

  @@index([result, createdAt])
  @@index([opportunityId])
}

model Revenue {
  id              String   @id @default(cuid())
  date            DateTime
  revenueSource   String
  grossRevenue    Float    @default(0)
  fees            Float    @default(0)
  advertisingCost Float    @default(0)
  otherCosts      Float    @default(0)
  netRevenue      Float    @default(0)
  currency        String   @default("USD")
  referenceNote   String   @default("")
  
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  
  // Phase 5.5 — idempotent revenue ingestion (additive, optional). Null for
  // historical rows; when present, a unique violation is a DUPLICATE, so the
  // same payment can never be recorded twice. Written by the shared
  // revenueIdempotencyKey() rule — never by the API caller.
  idempotencyKey  String?  @unique

  // Phase 11.7 — evidence + service attribution. ALL ADDITIVE; every existing
  // writer is unaffected and historical rows keep their (null) values.
  //
  // revenueBasis separates what actually happened from what was modelled.
  // ACTUAL is only reachable through an evidence-backed write (a signature-
  // verified provider event, or an approved admin manual verification).
  // ESTIMATED / PROJECTED / SIMULATED rows exist for planning and learning but
  // are NEVER summed into recognized revenue.
  revenueBasis    String   @default("ACTUAL") // ACTUAL | ESTIMATED | PROJECTED | SIMULATED
  recognizedUsd   Float    @default(0)        // ACTUAL rows only; reduced by refunds
  refundTotalUsd  Float    @default(0)
  serviceEngagementId String?
  serviceEngagement   ServiceEngagement? @relation(fields: [serviceEngagementId], references: [id])
  milestoneId     String?
  milestone       Milestone? @relation(fields: [milestoneId], references: [id])
  paymentEventId  String?
  paymentEvent    PaymentEvent? @relation(fields: [paymentEventId], references: [id])
  evidenceBasis   String   @default("PROVIDER_WEBHOOK")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([revenueBasis])
  @@index([serviceEngagementId])
  @@index([milestoneId])
}

model Affiliate {
  id              String   @id @default(cuid())
  merchant        String
  product         String
  category        String   @default("")
  affiliateProgram String  @default("")
  commissionType  String   @default("")
  commissionRate  Float    @default(0)
  affiliateUrl    String   @default("")
  productUrl      String   @default("")
  lastChecked     DateTime?
  linkStatus      String   @default("ACTIVE")
  disclosureStatus String  @default("REQUIRED")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Content {
  id              String   @id @default(cuid())
  title           String
  type            String
  body            String   @default("")
  seoTitle        String   @default("")
  metaDescription String   @default("")
  status          String   @default("DRAFT")
  
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Persistent record of one bounded Opportunity → Product pipeline run
// (Phase 5: unified workflow). Stores durable, reviewable state: lifecycle
// stage positions, per-step status, provenance rollups, and next actions.
// Provenance rules: AI-derived payloads stay AI_INFERENCE (stored with the
// step outputs they came from); VERIFIED_DATA is only ever the DB record
// references themselves. This model never invents market/revenue facts.
// Evidence cache + provenance store for the Real Research Engine.
// One row per unique (url, query) fetch result so repeated research does not
// re-hit external sources. Provenance rules:
// - evidenceType is VERIFIED_DATA ONLY when content was actually fetched and
//   passed validation; SEARCH_DISCOVERY marks search-result metadata (title/
//   snippet from a search provider) which was never fetched.
// - AI interpretation of this evidence is stored separately as AI_INFERENCE
//   and can NEVER upgrade a row's evidenceType.
// - No market size, customer counts, prices, or revenue figures are stored
//   here; extraction only keeps observed page text (see extraction.ts).
model EvidenceItemModel {
  id             String   @id @default(cuid())

  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])

  // Identity + provenance of the source.
  url            String
  domain         String
  query          String   @default("")
  sourceType     String   @default("WEB_PAGE")

  // VERIFIED_DATA (fetched + validated) or SEARCH_DISCOVERY (search metadata only).
  evidenceType   String

  // Extraction output.
  title          String   @default("")
  excerpt        String   @default("")

  // Fetch metadata (verifiability).
  httpStatus     Int?
  contentType    String?
  contentLength  Int?
  fetchedAt      DateTime
  retrievedVia   String   @default("direct_fetch")

  // Cache control.
  fetchDurationMs Int?
  cache          Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([url, query])
  @@index([opportunityId])
  @@index([fetchedAt])
}

model PipelineRun {
  id             String   @id @default(cuid())

  // The opportunity this run operated on. Optional: a run may start from a
  // free-form objective before any opportunity record is selected.
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])

  // Snapshot of the objective at run time (never mutated afterwards).
  objective      String

  // Denormalized display state for fast dashboards: lifecycle stage + run outcome.
  currentStage   String
  status         String   // COMPLETED, PARTIAL, BLOCKED, HUMAN_REVIEW, FAILED

  // Full machine-readable run payload (steps, outputs, provenance, actions).
  result         String

  // Aggregated AI usage for the whole run (sums across steps; estimates only).
  aiInputTokens  Int?
  aiOutputTokens Int?
  estimatedCostUsd Float?

  startedAt      DateTime @default(now())
  completedAt    DateTime?
  durationMs     Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================================
// SECURITY (Security Hardening Phase)
// ============================================================================

/// Append-only security audit trail. Records security-relevant events
/// (auth failures, rate-limit rejections, oversized requests, webhook
/// verification outcomes). NEVER stores secrets, tokens, credentials, or
/// raw request bodies — `detail` is a short, human-safe classification.
model SecurityEvent {
  id        String   @id @default(cuid())
  /// Event class, e.g. AUTH_FAILURE, RATE_LIMITED, REQUEST_TOO_LARGE, WEBHOOK_REJECTED.
  kind      String
  /// Coarse outcome category (ok | refused | error) — never a secret.
  outcome   String
  /// Which surface produced the event, e.g. "api:agents/execute", "webhook:polar".
  surface   String
  /// Short, safe classification string. Truncated to 300 chars; no secrets.
  detail    String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([surface, createdAt])
}

/// Durable rate-limit counters. Process-memory maps are per-instance and
/// vanish on restart, so they must never be the only production protection.
/// This table gives every deployment instance a shared, DB-backed counter.
model RateLimitWindow {
  id        String   @id @default(cuid())
  /// Bucket identifier, e.g. "agents_execute|ip:1.2.3.4".
  bucketKey String
  /// Epoch-second-aligned window label, e.g. "1700000000-60".
  windowKey String
  count     Int      @default(0)
  expiresAt DateTime

  @@unique([bucketKey, windowKey])
  @@index([expiresAt])
}

// Phase 4.5.2 — Ruflo-ready job orchestration.
// One row per queued/executed job (single agent or bounded pipeline). The job
// layer ENFORCES the existing safety architecture: a NOT_ALLOWED opportunity
// transitions to BLOCKED before any agent/AI invocation; REVIEW_REQUIRED goes
// to HUMAN_REVIEW with no autonomous execution. Idempotency: idempotencyKey
// (jobType:correlationId) is unique, so re-queuing the same logical work
// returns the existing row instead of double-executing.
// Phase 8 (Rule 11) — OAuth/authorization ledger. One row per (provider,
// scope); tokens are stored server-side as opaque ciphertext material and are
// never returned by any accessor. The state machine (NOT_CONNECTED →
// AUTHORIZING → CONNECTED → EXPIRED/REVOKED/ERROR) is deterministic; expired
// grants are never silently reused.
model IntegrationAuthorization {
  id                     String   @id @default(cuid())
  providerId             String
  scope                  String?
  state                  String   @default("NOT_CONNECTED")
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  expiresAt              DateTime?
  grantedScopes          String   @default("[]")
  metadata               String   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, scope])
}

model JobRun {
  id             String   @id @default(cuid())

  jobType        String   // RESEARCH, VALIDATION, PRODUCT, ANALYTICS, BUSINESS_MANAGER, OPPORTUNITY_PIPELINE
  status         String   // QUEUED, RUNNING, SUCCEEDED, FAILED, BLOCKED, HUMAN_REVIEW, DEGRADED

  // Idempotency/dedup identifier. Unique per (jobType, correlationId).
  correlationId  String
  idempotencyKey String   @unique

  // Optional opportunity scope; halal gating applies when present.
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])

  // Resolved executor: an agent type (single-agent jobs) or the pipeline.
  agentType      String?

  // Job payload (JSON). Contains user inputs only — never secrets.
  input          String   @default("{}")

  // Output reference: AgentLog id / PipelineRun id, plus a compact provenance
  // summary. Full payloads stay in AgentLog/PipelineRun — no duplication.
  resultRef      String?
  output         String?
  error          String?

  retryCount     Int      @default(0)
  executionMode  String?  // LIVE or MOCKED at execution time

  createdAt      DateTime @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([jobType, createdAt])
  @@index([correlationId])
}

// Phase 5.2 — Ruflo workflow runs. One row per state-aware workflow execution
// (OPPORTUNITY_DISCOVERY, OPPORTUNITY_TO_PRODUCT, BUSINESS_ANALYSIS,
// FULL_INCOME_PIPELINE). Stores the planner's decisions (which steps were
// necessary, skipped, or blocked and why) plus per-step outcomes — an
// auditable record of "why the system did less work". Safety: workflows
// execute through the existing JobRun/AgentLog stack; this model only records
// workflow-level state and never bypasses halal or human-review gates.
model WorkflowRun {
  id            String   @id @default(cuid())

  workflowType  String   // OPPORTUNITY_DISCOVERY, OPPORTUNITY_TO_PRODUCT, BUSINESS_ANALYSIS, FULL_INCOME_PIPELINE
  status        String   // COMPLETED, PARTIAL, BLOCKED, HUMAN_REVIEW, FAILED

  correlationId String
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  // Planner decisions and per-step outcomes (JSON; safe fields only).
  plan          String   @default("{}")
  steps         String   @default("[]")

  startedAt     DateTime
  completedAt   DateTime
  durationMs    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workflowType, createdAt])
  @@index([correlationId])
  @@index([status])
}

// Phase 5.4 — Provider-agnostic product event ingestion (VISITOR, PAGE_VIEW,
// PRODUCT_VIEW, CTA_CLICK, CHECKOUT_STARTED, PURCHASE, REFUND). One row per
// recorded event with provenance and an idempotency key: re-ingesting the same
// logical event is a no-op, never a duplicate. No personal data beyond an
// anonymous session identifier; no fabricated events (rows are written only
// from validated ingestion calls). The Growth Engine consumes these rows.
model ProductEvent {
  id              String   @id @default(cuid())

  productId       String
  product         Product  @relation(fields: [productId], references: [id])

  eventType       String   // VISITOR, PAGE_VIEW, PRODUCT_VIEW, CTA_CLICK, CHECKOUT_STARTED, PURCHASE, REFUND
  occurredAt      DateTime

  // Optional business scope.
  campaignId      String?
  opportunityId   String?
  experimentId    String?

  // Anonymous session/visitor identifier (no PII).
  sessionId       String?

  // For PURCHASE/REFUND: verified monetary value from the recording source.
  amountUsd       Float?

  // Phase 8 (Rules 6–7) — distribution attribution (additive, optional, non-PII).
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  referrer        String?
  landingPage     String?

  // Provenance of the event itself.
  source          String   // e.g. 'manual', 'provider:<id>' — who recorded it
  evidenceType    String   @default("VERIFIED_DATA")  // VERIFIED_DATA or USER_ENTERED only

  // Idempotency: re-ingesting the same logical event is a no-op.
  idempotencyKey  String   @unique

  @@index([productId, utmCampaign])

  createdAt       DateTime @default(now())

  @@index([productId, occurredAt])
  @@index([productId, eventType])
}

model AgentLog {
  id              String   @id @default(cuid())
  agentType       String
  action          String
  input           String   @default("")
  output          String   @default("")
  reasoning       String   @default("")
  evidenceType    String   @default("AI_INFERENCE")  // AI_INFERENCE, VERIFIED_DATA, USER_ENTERED
  aiProvider      String?
  aiModel         String?
  inputTokens     Int?
  outputTokens    Int?
  estimatedCostUsd Float?
  fallbackUsed    Boolean  @default(false)

  // Phase 4.5.1 (AI Usage & Cost Center): additive usage-attribution fields.
  // purpose is the AiPurpose label from the generation layer (e.g.
  // 'research.findings'); latencyMs is the wall-clock execution time of the
  // agent step; success records the AgentResult outcome. All three are
  // optional so historical rows (written before this change) aggregate
  // unchanged — unknown values are reported as 'unknown', never guessed.
  purpose         String?
  latencyMs       Int?
  success         Boolean?

  // Phase 5.4 — Product-level AI cost attribution (all optional; additive
  // only). Historical rows aggregate unchanged. Attribution is written ONCE
  // per AI execution by the generation choke point; per-product aggregates
  // sum these rows so the same execution can never be double-counted.
  productId       String?
  opportunityId   String?
  experimentId    String?
  jobId           String?
  correlationId   String?

  createdAt       DateTime @default(now())

  @@index([agentType, createdAt])
  @@index([createdAt])
  @@index([productId])
  @@index([opportunityId])
}

// ============================================================================
// PHASE 8 — Production Hardening + Autonomous Operations Layer
// Additive only. Never stores simulated revenue as real Revenue rows.
// ============================================================================

/// Durable agent mission. Execution always goes through the Job Runner;
/// this model never bypasses halal, human-review, or publishing gates.
model AgentMission {
  id                   String   @id @default(cuid())
  objective            String
  opportunityId        String?
  opportunity          Opportunity? @relation(fields: [opportunityId], references: [id])
  agentType            String
  constraints          String   @default("[]")
  budgetUsd            Float    @default(0)
  allowedCapabilities  String   @default("[]")
  expectedOutput       String   @default("")
  successCriteria      String   @default("")
  failureCriteria      String   @default("")
  deadlineAt           DateTime?
  timeoutMs            Int      @default(120000)
  approvalRequired     Boolean  @default(false)
  status               String   @default("QUEUED")
  failureReason        String?
  correlationId        String
  retryCount           Int      @default(0)
  resumePoint          String?
  lastError            String?
  failureClass         String?
  jobId                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  startedAt            DateTime?
  completedAt          DateTime?

  @@unique([correlationId])
  @@index([status])
  @@index([opportunityId, createdAt])
  @@index([agentType, createdAt])
}

/// Auditable autonomous-loop transition. One row per attempted stage move.
/// from/to/reason/evidence/correlationId/timestamp/status are always present.
model LoopTransition {
  id              String   @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  fromStage       String
  toStage         String
  reason          String
  evidence        String   @default("")
  evidenceType    String   @default("VERIFIED_DATA")
  correlationId   String
  status          String
  mode            String   @default("LIVE")
  createdAt       DateTime @default(now())

  @@index([opportunityId, createdAt])
  @@index([correlationId])
}

/// Paper-income / simulation run. Label is always SIMULATED.
/// These rows MUST never be copied into the Revenue table.
model SimulationRun {
  id               String   @id @default(cuid())
  seed             String
  opportunityId    String?
  opportunity      Opportunity? @relation(fields: [opportunityId], references: [id])
  mode             String   @default("SIMULATION")
  traffic          Int      @default(0)
  conversionRate   Float    @default(0)
  revenueUsd       Float    @default(0)
  costsUsd         Float    @default(0)
  profitUsd        Float    @default(0)
  label            String   @default("SIMULATED")
  stages           String   @default("[]")
  decision         String?
  realTransaction  Boolean  @default(false)
  correlationId    String
  createdAt        DateTime @default(now())

  @@index([opportunityId, createdAt])
  @@index([correlationId])
}

/// Structured operational memory (not chat history). Entries without
/// sufficient provenance must never be treated as verified truth.
model OperationalMemory {
  id                 String   @id @default(cuid())
  category           String
  source             String
  evidenceType       String
  relatedEntityType  String?
  relatedEntityId    String?
  opportunityId      String?
  opportunity        Opportunity? @relation(fields: [opportunityId], references: [id])
  observation        String
  outcome            String   @default("")
  applicability      String   @default("")
  confidence         Float    @default(0)
  createdAt          DateTime @default(now())

  @@index([category, createdAt])
  @@index([relatedEntityType, relatedEntityId])
  @@index([opportunityId])
}

/// Classified failure + recovery state. Bounded retries; dead-letter when exhausted.
model FailureRecord {
  id                 String   @id @default(cuid())
  classification     String
  retryCount         Int      @default(0)
  maxRetries         Int      @default(3)
  lastError          String
  recoveryState      String   @default("OPEN")
  deadLettered       Boolean  @default(false)
  resumePoint        String?
  correlationId      String
  relatedEntityType  String?
  relatedEntityId    String?
  opportunityId      String?
  opportunity        Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([classification, createdAt])
  @@index([correlationId])
  @@index([recoveryState])
}

/// Phase 9 — bounded per-opportunity resource budget. One row per
/// opportunity (upserted). All caps are hard limits enforced in code before
/// any experiment is created; the loop can never raise them autonomously.
model ResourceAllocation {
  id                 String   @id @default(cuid())
  opportunityId      String   @unique
  opportunity        Opportunity @relation(fields: [opportunityId], references: [id])
  portfolioItemId    String?
  portfolioItem      PortfolioItem? @relation(fields: [portfolioItemId], references: [id])

  monthlyBudgetUsd   Float    @default(0)
  spentThisMonthUsd  Float    @default(0)
  perExperimentCapUsd Float
  maxActiveExperiments Int  @default(2)
  paused             Boolean  @default(false)
  pauseReason        String?
  note               String   @default("")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([paused])
}
/// HIGH-1 — Opportunity handoff received from an external agent sender.
///
/// One row per accepted delivery envelope. The row IS the idempotency
/// record: `idempotencyKey` is unique, so a replayed delivery collapses to a
/// duplicate response and never creates a second job or a second opportunity.
///
/// Safety properties enforced by the receiver (src/lib/integrations/handoff):
/// - The envelope carries DATA only. It is never interpreted as instructions
///   and never executed directly; accepted work is handed to the Job Runner.
/// - `eligibility` carries the sender's declared eligibility, which the
///   receiver re-derives from the existing halal gate. A sender claiming
///   ALLOWED can never override a locally-computed NOT_ALLOWED/REVIEW_REQUIRED.
/// - `halalStatus` is always the LOCALLY computed value, never the asserted one.
model OpportunityHandoff {
  id               String   @id @default(cuid())

  /// Contract version of the delivery envelope. Only versions listed in
  /// src/lib/integrations/handoff are accepted; unknown versions are rejected.
  contractVersion  String
  /// Sender-assigned contract instance id (audit correlation, not unique).
  contractId       String
  /// Caller-supplied idempotency key. UNIQUE — the duplicate-delivery guard.
  idempotencyKey   String   @unique
  /// Correlation id threaded through the Job Runner and every audit record.
  correlationId    String

  /// Narrow event type the sender is delivering (e.g. OPPORTUNITY_PROPOSED).
  eventType        String
  /// Fingerprint of the authenticated sender identity (never the credential).
  senderIdentity   String

  /// Short, human-readable title supplied by the sender. Untrusted text.
  title            String
  /// Opaque JSON payload as delivered. Stored as a string, never executed and
  /// never concatenated into SQL, prompts, or shell commands.
  payloadJson      String

  /// Sender-asserted eligibility. Recorded for audit only — never trusted.
  assertedEligibility String
  /// Eligibility re-derived by the server from the existing halal gate.
  eligibility      String
  /// Locally computed halal verdict (HALAL | REVIEW_REQUIRED | NOT_ALLOWED).
  halalStatus      String
  /// Job type the receiver dispatched through the Job Runner.
  jobType          String
  /// Outcome of the handoff: ACCEPTED | DUPLICATE | REJECTED | BLOCKED.
  status           String
  /// Correlation id of the dispatched JobRun, when one was created.
  jobRunId         String?
  /// Opportunity created by the dispatched job, when applicable.
  opportunityId    String?
  /// Short, safe reason string. Never contains secrets or full payloads.
  reason           String   @default("")

  receivedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, receivedAt])
  @@index([correlationId])
  @@index([eventType, receivedAt])
  @@index([opportunityId])
}

// ============================================================================
// AGENT INTEGRATION CONTRACT v1 (Phase 1 — external AI Agent boundary)
// ============================================================================

/// Append-only audit record for ONE externally-submitted agent action.
///
/// The row IS the idempotency record: `requestId` is UNIQUE, so a replayed
/// request collides here and returns the stored response instead of executing
/// again — no second job, revenue row, experiment, product, or config change.
///
/// Execution authority stays with the EXISTING Job Runner: this row is durable
/// evidence, never an executor, and it never bypasses halal, budget, or
/// human-review gates.
///
/// Security properties:
/// - The credential is NEVER stored — only a keyed HMAC fingerprint.
/// - `agentId` is the server-verified identity bound to the credential, never
///   a client-asserted value.
/// - `authorizationResult` and `safetyVerdict` are always LOCALLY derived.
/// - `resultJson` holds a bounded, secret-free response snapshot so replays
///   return the same answer without re-executing.
model AgentActionRecord {
  id            String   @id @default(cuid())
  /// Server-verified agent identity (must match the credential's bound id).
  agentId       String
  /// Self-declared agent runtime version (audit/informational, bounded).
  agentVersion  String
  /// Capability id from the v1 catalog (e.g. WRITE_RESEARCH_EVIDENCE).
  action        String
  /// Caller-supplied idempotency key. UNIQUE — the duplicate-request guard.
  requestId     String   @unique
  /// Correlation id threaded into the Job Runner and every audit record.
  correlationId String
  /// ALLOWED | DENIED_CAPABILITY — server-derived, never client-asserted.
  authorizationResult String
  /// HALAL | REVIEW_REQUIRED | NOT_ALLOWED | NOT_APPLICABLE — locally recomputed.
  safetyVerdict String
  /// ACCEPTED | DUPLICATE | REJECTED | BLOCKED | HUMAN_APPROVAL_REQUIRED | FAILED
  status        String
  /// JobRun.id when the action dispatched through the Job Runner.
  jobId         String?
  /// HumanReview.id when the action required human approval.
  reviewId      String?
  /// Bounded JSON response snapshot (safe fields only; never secrets).
  resultJson    String   @default("{}")
  /// Short, human-safe reason. Never contains secrets or raw payloads.
  reason        String   @default("")
  /// Keyed HMAC fingerprint of the presented credential (never the credential).
  agentFingerprint String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([agentId, createdAt])
  @@index([correlationId])
  @@index([status, createdAt])
}

// =============================================================================
// AGENCY UPGRADE — single-admin autonomous agency layer (additive only).
//
// These models ADD observability and governance on top of the existing stack;
// they never replace JobRun/AgentLog/WorkflowRun (the authoritative execution
// record) and never duplicate existing models. Every table is written only
// through src/lib/agency/* which composes the existing Job Runner, halal gate
// and security guards — the tables themselves hold no execution authority.
// =============================================================================

/// Single-admin session record. There is NO public signup: the only credential
/// source is the server-side env config (ADMIN_EMAIL / ADMIN_PASSWORD_HASH),/// verified with constant-time comparison; the plaintext password is never
/// stored. One row per authenticated browser session; expiry is enforced.
model AdminSession {
  id             String   @id @default(cuid())
  /// Opaque random token presented as an httpOnly cookie value. Only the
  /// keyed fingerprint (HMAC) is stored — a stolen DB dump cannot mint cookies.
  tokenFingerprint String
  /// Always the single configured admin identity; kept for audit clarity.
  email          String
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  lastSeenAt     DateTime @default(now())
  /// Short, safe context string (fingerprinted IP). Never a raw credential.
  createdBy      String   @default("")

  @@unique([tokenFingerprint])
  @@index([expiresAt])
}

/// Typed Agent Contract, one row per roster agent. Contracts are seeded from
/// the static definitions in src/lib/agency/contracts.ts; runtime code treats
/// the in-code definition as authoritative and this row as durable evidence.
model AgentDefinition {
  id                 String   @id @default(cuid())
  agentId            String   @unique   // 'business-manager', 'research', …
  role               String
  mission            String
  allowedTools       String   @default("[]")   // JSON array of tool ids
  allowedStages      String   @default("[]")   // JSON array of stage names
  forbiddenActions   String   @default("[]")   // JSON array
  budgetLimitUsd     Float    @default(0)
  timeoutMs          Int      @default(120000)
  maxRetries         Int      @default(2)
  requiresApproval   Boolean  @default(false)
  stopConditions     String   @default("[]")   // JSON array of strings
  evidenceRequirement String  @default("AI_INFERENCE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// One supervised run per dispatched job. Extends — never replaces — JobRun:
/// the jobId column references the authoritative JobRun row.
model AgentRun {
  id             String   @id @default(cuid())
  agentId        String
  jobId          String?            // JobRun.id (authoritative execution record)
  jobType        String
  stage          String             // DISCOVER..LOOP stage label
  status         String             // QUEUED RUNNING SUCCEEDED FAILED BLOCKED HUMAN_REVIEW DEGRADED QUARANTINED
  correlationId  String
  lifecycleSteps String  @default("[]")  // JSON: [{step, outcome, detail}]
  safetyVerdict  String?            // HALAL / REVIEW_REQUIRED / NOT_ALLOWED
  verification   String?            // PASSED / FAILED / NOT_APPLICABLE
  failureReason  String?
  evidenceRefs   String  @default("[]")  // JSON array of {type, id}
  retryCount     Int     @default(0)
  startedAt      DateTime @default(now())
  completedAt    DateTime?

  @@index([agentId, startedAt])
  @@index([correlationId])
  @@index([jobId])
  @@index([status])
}

/// Allow-listed directional agent message (corr/job IDs, structured payload).
model AgentMessage {
  id             String   @id @default(cuid())
  correlationId  String
  jobId          String?
  sourceAgent    String
  targetAgent    String
  kind           String   // TASK_REQUEST | RESULT | FINDING | ESCALATION | DECISION
  payloadJson    String   @default("{}")  // bounded JSON, data only
  evidenceRefs   String   @default("[]")
  createdAt      DateTime @default(now())

  @@index([correlationId])
  @@index([targetAgent, createdAt])
  @@index([sourceAgent, createdAt])
}

/// Deterministic health snapshot per agent (latest wins via upsert).
model AgentHealth {
  id             String   @id @default(cuid())
  agentId        String   @unique
  state          String   // HEALTHY DEGRADED BLOCKED FAILED UNKNOWN
  reasons        String   @default("[]")  // JSON array of short strings
  successCount   Int      @default(0)
  failureCount   Int      @default(0)
  lastRunAt      DateTime?
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  evaluatedAt    DateTime @default(now())

  @@index([state])
}

/// Per-agent tool permission allow-list (seeded; additive governance layer).
model AgentPermission {
  id          String   @id @default(cuid())
  agentId     String
  tool        String
  effect      String   @default("ALLOW") // ALLOW (only effect seeded; DENY is implicit)
  scope       String   @default("")
  createdAt   DateTime @default(now())

  @@unique([agentId, tool])
}

/// Human review queue item. One row per action needing an admin decision.
model HumanReview {
  id             String   @id @default(cuid())
  category       String   // SAFETY_REVIEW | PUBLICATION | SPENDING | PAYMENT_CONFIG | SECURITY_CHANGE | DESTRUCTIVE_DB | CREDENTIALS | IRREVERSIBLE
  title          String
  detail         String   @default("")
  status         String   @default("PENDING") // PENDING APPROVED REJECTED PAUSED RETIRED
  requestedBy    String             // agent id ('system' for engine requests)
  opportunityId  String?
  evidenceRefs   String  @default("[]")
  decisionNote   String?
  decidedBy      String?
  decidedAt      DateTime?
  correlationId  String?
  createdAt      DateTime @default(now())

  @@index([status, createdAt])
  @@index([category])
}

/// Supervisor evaluation per run (loop protection + budget + safety verdicts).
model SupervisorEvaluation {
  id             String   @id @default(cuid())
  agentRunId     String?
  correlationId  String
  planValid      Boolean
  outputValid    Boolean
  loopDetected   Boolean  @default(false)
  loopReason     String?
  budgetViolation Boolean @default(false)
  safetyViolation Boolean @default(false)
  verdict        String   // PROCEED | QUARANTINE | PAUSE | ESCALATE
  reasons        String   @default("[]")
  harnessStatus  String   @default("NOT_CONNECTED")
  evaluatedAt    DateTime @default(now())

  @@index([correlationId])
  @@index([verdict, evaluatedAt])
}

/// Agency-level control switches (single row; upserted). Emergency PAUSE ALL
/// flips paused=true and is audited; state is preserved, never reset.
model AgencyControl {
  id           String   @id @default(cuid())
  key          String   @unique   // 'autonomy'
  paused       Boolean  @default(false)
  pauseReason  String?
  pausedBy     String?
  pausedAt     DateTime?
  updatedAt    DateTime @updatedAt
}

// ============================================================================
// PHASE 11.1 — SECURE INCOME FOUNDATION (Prospect + Conversation + Message)
//
// The earliest foundation of the client/service income loop designed in
// docs/phase-11-design.md (Phase 11.0). ADDITIVE ONLY: the existing digital-
// product architecture (Opportunity/Product/Factory/Revenue/agents) is
// unchanged — a digital product NEVER requires a Prospect, Conversation or
// Message. These tables hold NO execution authority: client messages are
// DATA, never authority (docs/phase-11-design.md §15, §18).
//
// Deliberately NOT here (later phases): Proposal, ProposalVersion,
// ServiceEngagement, Milestone, Deliverable, ServiceIssue, email providers,
// outreach execution. Phase 11.1 stores and classifies; nothing is sent.
// ============================================================================

/// A business-level prospect for future client/service work. Identity is
/// deliberately minimal (business contact data only — PII minimization);
/// no people-search fields. Lifecycle/risk states are validated via code
/// constants (src/lib/clients/prospect-states.ts) — no arbitrary writes.
model Prospect {
  id             String   @id @default(cuid())
  lifecycleState String   @default("NEW")   // NEW UNVERIFIED QUALIFIED CONTACTED CLIENT LOST BLOCKED
  riskState      String   @default("NEW")   // NEW UNVERIFIED LOW_RISK NORMAL REVIEW_REQUIRED PAYMENT_REQUIRED PAYMENT_VERIFIED HIGH_RISK BLOCKED

  // Business-level contact (PII minimization — no personal-only fields).
  displayName    String
  email          String?
  emailDomain    String?                      // derived from email/website; consistency signal only
  website        String?
  businessInfo   String   @default("{}")      // bounded JSON: company, role, public channels

  // Provenance (mandatory source; discovery providers arrive in a later phase).
  source         String                       // DISCOVERY_PROVIDER | INBOUND | REFERRAL | MANUAL
  sourceProvider String?
  sourceRef      String?
  evidenceRefs   String   @default("[]")      // JSON array of {type, id} — provenance, never fabricated

  // Deterministic risk counters (explainable; no opaque AI score).
  acceptedCount      Int    @default(0)
  paidCount          Int    @default(0)
  failedPaymentCount Int    @default(0)
  disputeCount       Int    @default(0)
  chargebackCount    Int    @default(0)
  cancellationCount  Int    @default(0)
  scopeChanges       Int    @default(0)
  revisionOverruns   Int    @default(0)
  abuseFlags         Int    @default(0)
  injectionFlags     Int    @default(0)
  lifetimePaidUsd    Float  @default(0)
  lastRiskEvaluatedAt DateTime?

  // Outreach-protection foundation (Phase 11.1 NEVER sends outreach).
  optedOut          Boolean   @default(false)
  optedOutAt        DateTime?
  lastContactedAt   DateTime?
  contactAttempts   Int       @default(0)
  suppressionReason String?

  conversations Conversation[]
  proposals     Proposal[]
  engagements   ServiceEngagement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Duplicate-outreach prevention foundation: one prospect per business email.
  // NULL emails (not-yet-emailed prospects) are distinct by SQL semantics in
  // both PostgreSQL and SQLite.
  @@unique([email])
  @@index([lifecycleState])
  @@index([riskState])
  @@index([optedOut])
}

/// One conversation thread with one prospect. No email/provider wiring in
/// 11.1 — channel is recorded data, not a live connection.
model Conversation {
  id                   String @id @default(cuid())
  prospectId           String
  prospect             Prospect @relation(fields: [prospectId], references: [id])
  channel              String @default("EMAIL")   // EMAIL | PORTAL | API
  state                String @default("OPEN")    // OPEN REQUIREMENTS_READY PROPOSAL_PENDING CLOSED_BLOCKED CLOSED_LOST CLOSED_COMPLETED
  injectionFlagCount   Int    @default(0)
  prospectMessageCount Int    @default(0)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prospectId, state])
}

/// One immutable message in a conversation. Client content is UNTRUSTED DATA:
/// it can never mutate permissions, budgets, halal state, governance, or
/// payment state. trustFlags is a validated, bounded representation; body is
/// bounded (<= 10,000 chars) and never edited after persistence.
model Message {
  id                String   @id @default(cuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  direction         String   // INBOUND | OUTBOUND_INTERNAL | OUTBOUND_CLIENT
  role              String   // CLIENT | SYSTEM_DRAFT | AGENT | ADMIN
  body              String
  providerMessageId String?
  providerStatus    String?  // SENT DELIVERED BOUNCED COMPLAINED FAILED (provider ingest is a later phase)
  trustFlags        String   @default("[]")   // JSON array of validated trust-flag ids
  treatedAs         String   @default("DATA") // constant by construction: DATA, never AUTHORITY
  immutable         Boolean  @default(true)   // append-only history; no edits, no routine deletes

  createdAt DateTime @default(now())

  // Provider replay protection: a replayed provider message collapses to one
  // row. Both PostgreSQL and SQLite treat NULLs as distinct in unique
  // indexes, so non-provider messages (providerMessageId = NULL) are unaffected.
  @@unique([conversationId, providerMessageId])
  @@index([conversationId, createdAt])
  // Phase 11.9 — reverse edge for ServiceIssue traceability.
  serviceIssues  ServiceIssue[]
}

// ============================================================================
// PHASE 10A — AGENT CONTROL CENTER (additive governance layer)
//
// Runtime configuration as DATA, never source-code mutation. The dashboard
// writes rows here; the Supervisor/Job Runner stay the only execution
// authority and consulted control state. Rows in these tables hold NO
// execution authority by themselves and never bypass halal gates, budget
// caps, AgentPermission allow-lists, human review or audit.
// ============================================================================

/// Per-agent runtime control state, one row per roster agent (upserted).
/// Complements — never replaces — AgencyControl (global pause) and AgentRun
/// (real run records). desiredState is the admin's intent (RUNNING | PAUSED |
/// STOPPED | RESTARTING); derivedState is what the system can honestly
/// support right now (READY | PAUSED | STOPPED | RESTART_PENDING | BLOCKED |
/// ERROR). stopReason/pendingRestart explain the truth; nothing here claims a
/// process is live.
model AgentControlState {
  id              String   @id @default(cuid())
  agentId         String   @unique
  desiredState    String   @default("RUNNING") // RUNNING | PAUSED | STOPPED | RESTARTING
  derivedState    String   @default("READY")   // READY | PAUSED | STOPPED | RESTART_PENDING | BLOCKED | ERROR
  activeVersion   Int?                       // AgentConfigVersion.version currently in force (null = static contract only)
  pendingRestart  Boolean  @default(false)
  stopReason      String?
  updatedBy       String?
  updatedAt       DateTime @updatedAt

  @@index([desiredState])
}

/// Immutable per-agent runtime configuration versions (append-only). One row
/// per saved config; rollback creates a NEW version (v4 = copy of v1), never
/// an update or delete of history. Only SAFE fields are persisted — never
/// secrets. Bounds mirror the static contract schema (src/lib/agency/contracts.ts)
/// so a stored version can never exceed what the contracts permit.
model AgentConfigVersion {
  id              String   @id @default(cuid())
  agentId         String
  version         Int
  configJson      String              // bounded JSON of safe fields only
  changedFields   String   @default("[]") // JSON array of field names changed by this save
  reason          String?
  changedBy       String              // admin identity (email) from the verified session
  action          String              // SAVE | ROLLBACK | BOOTSTRAP
  createdAt       DateTime @default(now())

  @@unique([agentId, version])
  @@index([agentId, createdAt])
}

/// Append-only audit of every agent control action. Complements SecurityEvent
/// (which records refusals and auth outcomes) with the full control record:
/// action, target, admin, previous/new state, config version, result and
/// correlationId. Never stores secrets and never mutates earlier rows.
model AgentControlAction {
  id              String   @id @default(cuid())
  agentId         String   // target agent or '*' for stop-all/resume-all
  action          String   // PAUSE | RESUME | STOP | RESTART | SAVE_CONFIG | SAVE_RESTART | ROLLBACK | STOP_ALL | RESUME_ALL
  previousState   String?
  newState        String?
  configVersion   Int?
  result          String   // OK | FAILED | REFUSED
  failureReason   String?
  changedBy       String
  correlationId   String
  detail          String   @default("")  // bounded, secret-free summary
  createdAt       DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([correlationId])
  @@index([action, createdAt])
}

// ============================================================================
// PHASE 11.2 — GOVERNED INCOME OFFER + PROPOSAL FOUNDATION
// ============================================================================
// The governed commercial layer connecting validated opportunities and
// products to priced, finite-scope, immutable-versioned proposals.
// ADDITIVE ONLY: Opportunity / Product / Revenue / JobRun / AgentRun /
// HumanReview / LearningEntry / SecurityEvent are reused unchanged — this
// phase creates no duplicate business entities.
//
// Hard invariants (docs/phase-11-design.md §1, §5, §8, §9, §19):
// - An OFFER is an asking price for work that has NOT been sold. No Offer row
//   may ever imply that payment happened; payment truth lives exclusively on
//   ProposalVersion.paymentVerification* and Milestone (Phase 11.3), which are
//   reachable only through a PaymentVerificationSource.
// - PROPOSAL VERSIONS ARE APPEND-ONLY. An approved/sent version is frozen;
//   any commercial change creates a NEW version (version N+1) and supersedes
//   the old one. No update path to a locked version exists in the service.
// - SCOPE IS FINITE. ScopeItem rows carry an explicit classification
//   (IN_SCOPE | OUT_OF_SCOPE | ASSUMPTION | CHANGE_REQUEST); a request that
//   does not match an IN_SCOPE item of the currently approved version can
//   never be executed as in-scope work.
// - REVISIONS ARE FINITE. revisionAllowance is stored ON the immutable
//   version, so raising the limit is itself a priced change (new version).
// ============================================================================

/// One priced, sellable thing. The governed abstraction that makes digital
/// products, micro-services and client services first-class peers of the same
/// commercial pipeline without forking three architectures.
///   - DIGITAL_PRODUCT links a Product (self-serve purchase, no Prospect).
///   - MICRO_SERVICE / CLIENT_SERVICE link a Prospect via a Proposal.
/// `price` is the ASK, never money received. `paymentState` is the ONLY place
/// an offer's payment claim may live, and it is server-derived from a
/// verification source — never from a client message.
model Offer {
  id             String   @id @default(cuid())
  type           String   // DIGITAL_PRODUCT | MICRO_SERVICE | CLIENT_SERVICE
  title          String
  description    String   @default("")
  scopeSummary   String   @default("")   // short, bounded, non-binding summary (the binding scope lives on ProposalVersion)

  price          Float    @default(0)    // the ASK; > 0 required before an offer can be published/proposed
  currency       String   @default("USD")
  estimatedEffortHours Float @default(0)
  estimatedCost  Float    @default(0)
  estimatedMargin Float   @default(0)    // derived server-side (price - cost); never client-supplied

  // Provenance — where this offer came from. Never fabricated.
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])

  // Screening + governance (deterministic, code-validated).
  // halalStatus: HALAL | REVIEW_REQUIRED | BLOCKED | UNVERIFIED.
  // UNVERIFIED is the honest default — an unscreened offer is NOT halal.
  halalStatus    String   @default("UNVERIFIED")
  riskState      String   @default("UNVERIFIED")
  status         String   @default("DRAFT")  // DRAFT REVIEW_REQUIRED ACTIVE RETIRED BLOCKED

  // Payment truth for THIS offer (server-derived only; see Phase 11.3 Milestone
  // for the engagement-level ledger). Cannot become VERIFIED without a source.
  paymentState   String   @default("NOT_PAYMENT_VERIFIED")
  paymentVerificationSource String?
  paymentVerificationRef    String?

  // PHASE 11.9 GAP REMEDIATION (G1) — the PERSISTED routing decision.
  //
  // Phase 11.3 implemented routeOpportunity()/executionVerdict() as pure
  // functions that nothing in the production path ever called, so routing was
  // decoration. These columns make the routing verdict a real, recorded fact
  // computed at offer creation from the ALREADY-screened offer type and the
  // opportunity's PERSISTED halal verdict — never from untrusted content.
  //
  // route is one of ROUTE_JOB_TYPES' routes; routeJobTypes is a JSON array of
  // the EXISTING job types the route runs through (no second Job Runner).
  // routeExecutable is false whenever any blocker is present.
  route           String?
  routeJobTypes   String   @default("[]")
  routeExecutable Boolean  @default(false)
  routeBlockers   String   @default("[]")
  routeReason     String   @default("")
  routeResolvedAt DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  proposals      Proposal[]
  engagements    ServiceEngagement[]

  @@index([type, status])
  @@index([opportunityId])
  @@index([productId])
}

/// A proposal to one prospect for one offer. Holds lifecycle + which version is
/// current; the COMMERCIAL TERMS live on the immutable ProposalVersion rows.
model Proposal {
  id              String   @id @default(cuid())
  prospectId      String
  prospect        Prospect @relation(fields: [prospectId], references: [id])
  offerId         String
  offer           Offer    @relation(fields: [offerId], references: [id])
  opportunityId   String?

  state           String   @default("DRAFT")
  // DRAFT | INTERNAL_REVIEW | SENT | ACCEPTED | DECLINED | EXPIRED | SUPERSEDED
  //
  // approvalState is INTERNAL admin approval of the SEND action — it is never
  // set by a client message:
  // NOT_APPROVED | APPROVED_FOR_SEND | SEND_REFUSED
  approvalState   String   @default("NOT_APPROVED")
  approvedBy      String?
  approvedAt      DateTime?

  // The version whose terms currently bind. NULL until v1 exists; never
  // points at a superseded version.
  currentVersionId String?
  approvedVersionId String?   // the version accepted by the client (evidence-backed)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions       ProposalVersion[]
  engagements    ServiceEngagement[]
  changeRequests ScopeChangeRequest[]

  @@index([prospectId, state])
  @@index([state])
}

/// Immutable commercial terms. APPEND-ONLY: once `locked` is true no code path
/// updates any commercial field. `locked` becomes true when the version is
/// approved for send or sent — from that moment a change means a NEW version.
model ProposalVersion {
  id              String   @id @default(cuid())
  proposalId      String
  proposal        Proposal @relation(fields: [proposalId], references: [id])
  version         Int

  title           String
  summary         String   @default("")
  scopeItems      String   @default("[]")   // JSON [{id,title,classification,detail}]
  deliverables    String   @default("[]")   // JSON [{title,kind,description}]
  exclusions      String   @default("[]")   // JSON [string]
  assumptions     String   @default("[]")   // JSON [string]

  price           Float    @default(0)
  currency        String   @default("USD")
  estimatedTimeline String @default("")
  paymentTerms    String   @default("")

  // FINITE by construction (docs/phase-11-design.md §9).
  revisionAllowance Int   @default(2)

  validityDays    Int      @default(30)
  halalStatus     String   @default("UNVERIFIED")
  identityDisclosure String @default("AI-assisted business operator")

  // Provenance of the version — who/which system created it (never client input).
  createdBy       String   // admin email or 'system:<reason>'
  createdSource   String   @default("ADMIN")   // ADMIN | SYSTEM
  changeReason    String   @default("")

  // Immutable marker. Terminal: true once frozen. Never set back to false.
  locked          Boolean  @default(false)
  lockedAt        DateTime?
  createdAt       DateTime @default(now())

  changeRequests  ScopeChangeRequest[]
  scopeItemRows   ScopeItem[]

  @@unique([proposalId, version])
  @@index([proposalId, createdAt])
}

/// Finite scope, one row per explicit item on an immutable proposal version.
/// A requested item that matches NO IN_SCOPE row cannot be executed as in-scope
/// work — it must become a ScopeChangeRequest instead (scope overrun).
model ScopeItem {
  id                String   @id @default(cuid())
  proposalVersionId String
  proposalVersion   ProposalVersion @relation(fields: [proposalVersionId], references: [id])

  itemKey           String   // stable key inside the version's scope contract
  title             String
  // IN_SCOPE | OUT_OF_SCOPE | ASSUMPTION | CHANGE_REQUEST
  classification    String   @default("IN_SCOPE")
  detail            String   @default("")
  estimatedHours    Float    @default(0)

  createdAt         DateTime @default(now())

  @@unique([proposalVersionId, itemKey])
  @@index([classification])
}

/// A controlled request to exceed approved scope. NEVER executed directly:
/// overrun → REVIEW_REQUIRED → new proposal version → approval → payment if
/// applicable → execution. Created from a client message WITHOUT trusting it:
/// the message is data; the classification is deterministic, and the
/// human/admin is the only actor who can convert it into a priced version.
model ScopeChangeRequest {
  id                String   @id @default(cuid())
  proposalId        String
  proposal          Proposal @relation(fields: [proposalId], references: [id])
  proposalVersionId String?
  proposalVersion   ProposalVersion? @relation(fields: [proposalVersionId], references: [id])

  requestedSummary  String
  requestedDetail   String   @default("")
  // Deterministic classification of the REQUEST (never of the client's intent).
  classification    String   @default("SCOPE_CHANGE_REQUEST")
  status            String   @default("REVIEW_REQUIRED")
  // REVIEW_REQUIRED | APPROVED | REJECTED | CONVERTED_TO_VERSION

  sourceMessageId   String?   // provenance: the Message row this came from (DATA only)
  sourceFlag        String?   // the trust flag that raised it (SCOPE_CHANGE_REQUEST etc.)

  estimatedHours    Float    @default(0)
  estimatedCost     Float    @default(0)
  requiresPayment   Boolean  @default(true)

  resolvedVersionId String?
  resolutionNote    String   @default("")
  resolvedBy        String?
  resolvedAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([proposalId, status])
}

// ============================================================================
// PHASE 11.3 — EXECUTION + DELIVERY (client service + micro-service)
// ============================================================================
// Bounded, governed service execution. Everything here reuses the EXISTING
// Job Runner / AgentRun / Supervisor / Revenue / Learning machinery — there is
// no second job system. The tables below record STATE, never authority.
//
// HARD INVARIANT: UNPAID → EXECUTING is impossible by default.
// WORK_AUTHORIZED is reachable ONLY from PAYMENT_VERIFIED, which is reachable
// ONLY through a PaymentVerificationSource (PROVIDER_WEBHOOK | PROVIDER_API |
// MANUAL_ADMIN_APPROVED). The only exception is an explicitly configured
// low-risk exception (exposureCap + LOW_RISK/PAYMENT_VERIFIED prospect), OFF by
// default and always SecurityEvent-audited.
/// ============================================================================

/// One governed engagement: an accepted proposal version plus its execution,
/// delivery and issue state. `engagementType` folds micro-services and client
/// services into the SAME tables — a micro-service is a smaller engagement,
/// not a parallel architecture.
model ServiceEngagement {
  id              String   @id @default(cuid())
  // MICRO_SERVICE | CLIENT_SERVICE
  engagementType  String   @default("CLIENT_SERVICE")

  offerId         String?
  offer           Offer?   @relation(fields: [offerId], references: [id])
  proposalId      String?
  proposal        Proposal? @relation(fields: [proposalId], references: [id])
  proposalVersionId String?
  opportunityId   String?
  prospectId      String?
  prospect        Prospect? @relation(fields: [prospectId], references: [id])

  title           String
  scopeSummary    String   @default("")

  // NO_COMMITMENT | PROPOSAL_SENT | ACCEPTED | PAYMENT_REQUIRED
  // | PAYMENT_PENDING | PAYMENT_VERIFIED | WORK_AUTHORIZED | WORK_IN_PROGRESS
  // | DELIVERABLE_READY | FINAL_PAYMENT_REQUIRED | DELIVERY_AUTHORIZED
  // | COMPLETED | PAUSED | TERMINATED | CANCELLED
  state           String   @default("NO_COMMITMENT")

  // Payment truth (server-derived only).
  paymentState    String   @default("NOT_DUE")
  // NOT_DUE | PAYMENT_REQUIRED | PAYMENT_PENDING | PAYMENT_VERIFIED | REFUNDED
  verificationSource String?  // PROVIDER_WEBHOOK | PROVIDER_API | MANUAL_ADMIN_APPROVED
  providerRef     String?
  verifiedAt      DateTime?

  // Explicit, bounded unpaid-exposure ceiling. 0 = no unpaid work at all.
  exposureCapUsd  Float    @default(0)
  lowRiskExceptionApplied Boolean @default(false)

  totalPrice      Float    @default(0)
  currency        String   @default("USD")

  workAuthorizedAt DateTime?
  completedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  milestones     Milestone[]
  deliverables   Deliverable[]
  issues         ServiceIssue[]
  revenue        Revenue[]
  costs          EngagementCost[]
  paymentEvents  PaymentEvent[]
  outreachSends  OutreachSend[]
  manualPaymentVerifications ManualPaymentVerification[]

  // Phase 11.7 — declared, bounded effort/cost envelope for this engagement.
  // These are ESTIMATES, never actuals, and are labelled as such everywhere.
  estimatedCostUsd Float @default(0)
  actualCostUsd    Float @default(0)

  // PHASE 11.9 GAP REMEDIATION (G8) — the bounded micro-service kind as a
  // STRUCTURED, queryable column.
  //
  // Phase 11.3 stored this as free text in a `[KIND] ...` prefix inside
  // scopeSummary. That was a real integrity problem, not cosmetic: the prefix
  // is user-editable prose, it is not indexed, and execution could not read it
  // authoritatively — the job runner instead trusted a caller-supplied payload
  // value. This column is the single authoritative record.
  //
  // Validated at write time by isMicroServiceKind() and re-validated at
  // execution time by findMicroService(); NULL for CLIENT_SERVICE engagements
  // and for every pre-existing row (additive migration, no backfill invented).
  microServiceKind String?

  // PHASE 11.9 (G2) — the bounded effort/revision envelope this engagement was
  // admitted under, snapshotted from the catalogue at creation so the bound is
  // reproducible even if the catalogue is edited later. NULL for CLIENT_SERVICE
  // and for pre-existing rows.
  microServiceEffortHours Float?
  microServiceRevisionLimit Int?

  @@index([state])
  @@index([engagementType, state])
  @@index([prospectId])
  @@index([opportunityId])
  @@index([microServiceKind])
}

/// A payment/acceptance step inside an engagement. The payment machine lives
/// here (docs/phase-11-design.md §3.4): a client claim can set PAYMENT_PENDING
/// at most — PAYMENT_VERIFIED requires a PaymentVerificationSource.
model Milestone {
  id            String   @id @default(cuid())
  engagementId  String
  engagement    ServiceEngagement @relation(fields: [engagementId], references: [id])

  key           String
  title         String
  percent       Int      @default(0)
  amountUsd     Float    @default(0)
  currency      String   @default("USD")

  paymentState  String   @default("NOT_DUE")
  verificationSource String?
  providerRef   String?
  verifiedAt    DateTime?

  acceptanceEvidence String?   // structured evidence; NEVER synthesized
  acceptedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  revenue       Revenue[]

  @@unique([engagementId, key])
  @@index([paymentState])
}

/// One deliverable with EXPLICIT states. A generated artifact is DRAFT until it
/// passes QA (distinct from generation), and DELIVERED is never ACCEPTED
/// without evidence. Finite revisions: exceeding revisionLimit lands in
/// REVISION_LIMIT_REACHED, which requires a paid change request to resume.
model Deliverable {
  id            String   @id @default(cuid())
  engagementId  String
  engagement    ServiceEngagement @relation(fields: [engagementId], references: [id])
  milestoneKey  String?

  title         String
  kind          String   // bounded deliverable kind, code-validated

  // DRAFT | QA_PENDING | QA_PASSED | READY_FOR_DELIVERY | DELIVERED
  // | CLIENT_REVIEW | ACCEPTED | REVISION_REQUESTED | REVISION_LIMIT_REACHED
  // | WITHHELD | COMPLETED
  state         String   @default("DRAFT")
  // PREVIEW vs FINAL_DELIVERABLE. A FINAL release requires QA_PASSED plus
  // DELIVERY_AUTHORIZED on the engagement.
  isPreview     Boolean  @default(false)

  artifactRefs  String   @default("[]")   // bounded refs only — never secrets, never client credentials
  revisionCount Int      @default(0)
  revisionLimit Int      @default(2)
  qaSummary     String   @default("")

  deliveredAt   DateTime?
  acceptedAt    DateTime?
  acceptanceEvidence String?   // evidence-backed; never fabricated, never inferred from silence

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([engagementId, state])
}

/// Disputes, cancellations, refunds, pauses. One table (docs/phase-11-design.md
/// §13). Every decision requires a human — the system only drafts.
model ServiceIssue {
  id            String   @id @default(cuid())
  engagementId  String
  engagement    ServiceEngagement @relation(fields: [engagementId], references: [id])

  // CANCELLATION_REQUESTED | CANCELLATION_APPROVED | DISPUTE | CHARGEBACK
  // | REFUND_REQUESTED | REFUND_PROCESSED | PAUSE_REQUESTED | TERMINATION_REQUESTED
  issueType     String
  status        String   @default("OPEN")   // OPEN | APPROVED | REJECTED | RESOLVED | PROCESSED
  summary       String   @default("")
  evidenceRefs  String   @default("[]")   // conversation + delivery history preserved

  requiresHuman Boolean  @default(true)
  decidedBy     String?
  decidedAt     DateTime?
  resolutionNote String  @default("")
  correlationId String   @default("")

  // PHASE 11.9 — TRIGGERING MESSAGE TRACEABILITY.
  // Phase 11.3 stored `client-message:<randomUUID()>` in correlationId, which
  // destroyed the audit trail: the generated UUID pointed at nothing, so a
  // client-sourced dispute could not be traced back to the message that caused
  // it. This column is a REAL foreign key to the triggering Message.
  //
  // Nullable: an admin-raised issue has no triggering message. Pre-existing
  // rows stay NULL rather than being backfilled with invented linkage.
  //
  // Note: Message.treatAs is constant 'DATA', never AUTHORITY, so a message
  // can TRIGGER an issue but can never resolve one — the human gate stands.
  messageId     String?
  message       Message? @relation(fields: [messageId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([engagementId])
  @@index([issueType, status])
  @@index([messageId])
}

// ============================================================================
// PHASE 11.4 — PAYMENT EVIDENCE LEDGER
// ============================================================================
// Payment truth is evidence-backed or it is nothing. This table is the single
// append-only record of every payment-bearing event the system was asked to
// trust, together with the VERDICT on it. Nothing here is mutable except the
// transition from RECORDED to REVERSED, and that transition is itself audited.
//
// Replay protection: `providerEventId` is UNIQUE per provider. A replayed
// webhook therefore collapses to a single row and can never move an engagement
// state twice or record revenue twice.
//
// Untrusted input classes are recorded as REJECTED rows rather than discarded,
// so "someone tried to claim payment from a screenshot" is auditable.
// ============================================================================
model PaymentEvent {
  id                String   @id @default(cuid())
  provider          String   @default("POLAR")
  // Provider-scoped event id. UNIQUE: this is the replay guard.
  providerEventId   String
  eventType         String
  // ACCEPTED | REJECTED | DUPLICATE | REVERSED | IGNORED
  outcome           String   @default("RECORDED")
  rejectionReason   String   @default("")

  // Signature verification result, decided by webhook-verification.ts (Phase 8).
  // A false value here means the payload was NEVER trusted for anything.
  signatureVerified Boolean  @default(false)
  verificationMethod String  @default("NONE")
  // PROVIDER_WEBHOOK | PROVIDER_API | MANUAL_ADMIN_APPROVED | NONE

  amountUsd         Float    @default(0)
  currency          String   @default("USD")

  // Intended target. A verified event with no engagement is still recorded,
  // but it can never authorize service work.
  engagementId      String?
  engagement        ServiceEngagement? @relation(fields: [engagementId], references: [id])
  milestoneId       String?
  offerId           String?

  // Bounded, non-secret provenance only (never a card number, never a body).
  evidenceRefs      String   @default("[]")
  receivedAt        DateTime @default(now())
  processedAt       DateTime?
  reversalOfId      String?
  reversalReason    String   @default("")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  revenue           Revenue[]

  @@unique([provider, providerEventId])
  @@index([engagementId, outcome])
  @@index([outcome, createdAt])
}

// ============================================================================
// PHASE 11.4 — CONTROLLED MANUAL PAYMENT VERIFICATION (admin review path)
// ============================================================================
// MANUAL_ADMIN_APPROVED is a legitimate source, but only as a *controlled*
// review: it must name a reviewer, record what evidence was examined, state a
// reason, and carry a timestamp. Without all four, the source is refused.
//
// This is deliberately NOT the PaymentEvent table: manual review is a distinct
// authority with a distinct audit shape, and conflating the two would let a
// webhook path borrow manual-review bookkeeping.
// ============================================================================
model ManualPaymentVerification {
  id                String   @id @default(cuid())
  engagementId      String
  engagement        ServiceEngagement @relation(fields: [engagementId], references: [id])
  milestoneId       String?

  // The human who performed the review. Required — an unattributed approval
  // is not an approval.
  reviewer          String
  reviewedAt        DateTime @default(now())
  // Why the reviewer concluded payment was made. Required, bounded, non-empty.
  reason            String
  // What was actually examined: bounded references only (bank ref, receipt id,
  // provider dashboard capture id). NEVER card data, never credentials.
  evidenceRefs      String   @default("[]")

  amountUsd         Float
  currency          String   @default("USD")

  // APPROVED | REFUSED
  outcome           String   @default("APPROVED")
  // Deterministic dedupe key so re-running the same review is idempotent.
  idempotencyKey    String   @unique

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([engagementId])
  @@index([outcome, createdAt])
}

// ============================================================================
// PHASE 11.7 — ENGAGEMENT COST LEDGER (actual vs estimated, kept distinct)
// ============================================================================
// Revenue already existed; cost at the ENGAGEMENT level did not. Without it,
// per-engagement P&L is impossible and "margin" is just price under a
// different name.
//
// basis is the whole point of this table:
//   ACTUAL     — an evidenced cost (a provider invoice row, a recorded fee).
//   ESTIMATED  — a planning figure. Never summed into realized profit.
//
// realizedCostUsd on EngagementEngagement aggregates ONLY ACTUAL rows.
// ============================================================================
model EngagementCost {
  id            String   @id @default(cuid())
  engagementId  String
  engagement    ServiceEngagement @relation(fields: [engagementId], references: [id])

  // AI_EXECUTION | TOOLING | INFRASTRUCTURE | PLATFORM_FEE | REFUND | OTHER
  category      String
  description   String   @default("")
  amountUsd     Float
  currency      String   @default("USD")
  // ACTUAL | ESTIMATED — an estimate is never presented as a real cost.
  basis         String   @default("ACTUAL")
  evidenceRefs  String   @default("[]")

  // Deterministic dedupe so the same evidenced cost cannot be counted twice.
  idempotencyKey String  @unique

  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([engagementId, basis])
}

// ============================================================================
// PHASE 11.5 — OUTBOUND COMMUNICATION LEDGER
// ============================================================================
// Provenance and duplicate-send prevention for governed outbound contact.
//
// `idempotencyKey` is UNIQUE: the same logical outreach can never be sent
// twice, so a retried request is an idempotent no-op rather than a second
// message to a real business.
//
// `contentDigest` records WHAT was screened, so an auditor can prove the copy
// that passed screening is the copy that was sent. `simulated` is carried
// explicitly: a test-adapter send must never be countable as a real send.
// ============================================================================
model OutreachSend {
  id              String   @id @default(cuid())
  prospectId      String?
  engagementId    String?
  engagement      ServiceEngagement? @relation(fields: [engagementId], references: [id])

  channel         String   // EMAIL | CLIENT_PORTAL | MESSAGING
  recipientDigest String   // hashed contact; the raw address is not duplicated here
  subjectDigest   String
  contentDigest   String

  // QUEUED | SENT | DELIVERED | BOUNCED | COMPLAINED | SUPPRESSED | FAILED
  status          String   @default("QUEUED")
  providerId      String
  providerMessageId String?
  simulated       Boolean  @default(false)

  // Bounded screening result: which gate refused, or that it passed.
  screeningResult String   @default("")
  approvedBy      String?
  idempotencyKey  String   @unique
  detail          String   @default("")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([prospectId, createdAt])
  @@index([status, createdAt])
}
