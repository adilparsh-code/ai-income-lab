generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Opportunity {
  id                    String   @id @default(cuid())
  title                 String
  category              String
  businessModel         String
  targetAudience        String
  problemSolved         String
  monetizationMethod    String
  estimatedStartupCost  Float    @default(0)
  
  // Scores (0-100)
  demandScore           Int      @default(0)
  competitionScore      Int      @default(0)
  commercialIntentScore Int      @default(0)
  automationScore       Int      @default(0)
  differentiationScore  Int      @default(0)
  monetizationScore     Int      @default(0)
  halalConfidenceScore  Int      @default(100)
  overallScore          Int      @default(0)
  
  halalStatus           String   @default("HALAL")    // HALAL, REVIEW_REQUIRED, NOT_ALLOWED
  confidenceLevel       String   @default("MEDIUM")   // VERY_HIGH, HIGH, MEDIUM, LOW, VERY_LOW, SAMPLE_DATA
  status                String   @default("IDEA")     // IDEA, RESEARCHING, VALIDATING, VALIDATED, BUILDING, PUBLISHED, EARNING, SCALING, PAUSED, REJECTED
  
  evidenceNotes         String   @default("")
  risks                 String   @default("")
  nextAction            String   @default("")
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastReviewedAt        DateTime?
  
  products              Product[]
  experiments           Experiment[]
  revenues              Revenue[]
  contents              Content[]
  pipelineRuns          PipelineRun[]
  evidenceItems         EvidenceItemModel[]
}

model Product {
  id              String   @id @default(cuid())
  name            String
  type            String
  targetAudience  String   @default("")
  status          String   @default("IDEA")
  price           Float    @default(0)
  cost            Float    @default(0)
  revenue         Float    @default(0)
  platform        String   @default("")
  productUrl      String   @default("")
  affiliateUrl    String   @default("")
  notes           String   @default("")
  
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?
  
  revenues        Revenue[]
  contents        Content[]
}

model Experiment {
  id              String   @id @default(cuid())
  hypothesis      String
  target          String   @default("")
  budget          Float    @default(0)
  startDate       DateTime?
  endDate         DateTime?
  expectedResult  String   @default("")
  actualResult    String   @default("")
  
  visitors        Int      @default(0)
  leads           Int      @default(0)
  clicks          Int      @default(0)
  sales           Int      @default(0)
  revenue         Float    @default(0)
  profit          Float    @default(0)
  conversionRate  Float    @default(0)
  
  decision        String?  // SCALE, ITERATE, PAUSE, KILL
  
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Revenue {
  id              String   @id @default(cuid())
  date            DateTime
  revenueSource   String
  grossRevenue    Float    @default(0)
  fees            Float    @default(0)
  advertisingCost Float    @default(0)
  otherCosts      Float    @default(0)
  netRevenue      Float    @default(0)
  currency        String   @default("USD")
  referenceNote   String   @default("")
  
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Affiliate {
  id              String   @id @default(cuid())
  merchant        String
  product         String
  category        String   @default("")
  affiliateProgram String  @default("")
  commissionType  String   @default("")
  commissionRate  Float    @default(0)
  affiliateUrl    String   @default("")
  productUrl      String   @default("")
  lastChecked     DateTime?
  linkStatus      String   @default("ACTIVE")
  disclosureStatus String  @default("REQUIRED")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Content {
  id              String   @id @default(cuid())
  title           String
  type            String
  body            String   @default("")
  seoTitle        String   @default("")
  metaDescription String   @default("")
  status          String   @default("DRAFT")
  
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Persistent record of one bounded Opportunity → Product pipeline run
// (Phase 5: unified workflow). Stores durable, reviewable state: lifecycle
// stage positions, per-step status, provenance rollups, and next actions.
// Provenance rules: AI-derived payloads stay AI_INFERENCE (stored with the
// step outputs they came from); VERIFIED_DATA is only ever the DB record
// references themselves. This model never invents market/revenue facts.
// Evidence cache + provenance store for the Real Research Engine.
// One row per unique (url, query) fetch result so repeated research does not
// re-hit external sources. Provenance rules:
// - evidenceType is VERIFIED_DATA ONLY when content was actually fetched and
//   passed validation; SEARCH_DISCOVERY marks search-result metadata (title/
//   snippet from a search provider) which was never fetched.
// - AI interpretation of this evidence is stored separately as AI_INFERENCE
//   and can NEVER upgrade a row's evidenceType.
// - No market size, customer counts, prices, or revenue figures are stored
//   here; extraction only keeps observed page text (see extraction.ts).
model EvidenceItemModel {
  id             String   @id @default(cuid())

  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])

  // Identity + provenance of the source.
  url            String
  domain         String
  query          String   @default("")
  sourceType     String   @default("WEB_PAGE")

  // VERIFIED_DATA (fetched + validated) or SEARCH_DISCOVERY (search metadata only).
  evidenceType   String

  // Extraction output.
  title          String   @default("")
  excerpt        String   @default("")

  // Fetch metadata (verifiability).
  httpStatus     Int?
  contentType    String?
  contentLength  Int?
  fetchedAt      DateTime
  retrievedVia   String   @default("direct_fetch")

  // Cache control.
  fetchDurationMs Int?
  cache          Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([url, query])
  @@index([opportunityId])
  @@index([fetchedAt])
}

model PipelineRun {
  id             String   @id @default(cuid())

  // The opportunity this run operated on. Optional: a run may start from a
  // free-form objective before any opportunity record is selected.
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])

  // Snapshot of the objective at run time (never mutated afterwards).
  objective      String

  // Denormalized display state for fast dashboards: lifecycle stage + run outcome.
  currentStage   String
  status         String   // COMPLETED, PARTIAL, BLOCKED, HUMAN_REVIEW, FAILED

  // Full machine-readable run payload (steps, outputs, provenance, actions).
  result         String

  // Aggregated AI usage for the whole run (sums across steps; estimates only).
  aiInputTokens  Int?
  aiOutputTokens Int?
  estimatedCostUsd Float?

  startedAt      DateTime @default(now())
  completedAt    DateTime?
  durationMs     Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AgentLog {
  id              String   @id @default(cuid())
  agentType       String
  action          String
  input           String   @default("")
  output          String   @default("")
  reasoning       String   @default("")
  evidenceType    String   @default("AI_INFERENCE")  // AI_INFERENCE, VERIFIED_DATA, USER_ENTERED
  aiProvider      String?
  aiModel         String?
  inputTokens     Int?
  outputTokens    Int?
  estimatedCostUsd Float?
  fallbackUsed    Boolean  @default(false)
  
  createdAt       DateTime @default(now())
}
